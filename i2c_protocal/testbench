module i2c_protocal_tb( );
reg clk,rst,ready;
reg [6:0] slave_add;
reg [7:0] data_in;
wire sda, scl,done;
assign scl=clk;
 i2c_protocal dut (clk,rst,ready,slave_add,data_in,scl,done,sda);
   initial begin 
   clk=0;
   rst=0;
   ready=0;
   slave_add=7'd0;
   data_in=8'd0;
   end 
   always #5 clk=~clk;
   initial begin
   $monitor ("%0t\t%d\t%b\t%h\t%h\t%b\t%b\t%b",$time,
   dut.state,ready,slave_add,data_in,sda,scl,done);
   rst=1'b1;
   $display ("[%0t],reset released",$time);
   ready=1'b0;
   slave_add=7'b1010101;
   data_in=8'hA5;
   #10;
   rst=1'b0;
   #10;
   ready =1'b1;
   $display ("[%0t],start the transection",$time);
   #10;
   wait(done);
    $display ("[%0t] transection completed ",$time);
   end 
   
endmodule
